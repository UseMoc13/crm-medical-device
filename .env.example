APP_NAME="CRM Medical Device"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 (development). Set these in your OWN .env.
# DB_URL=  # Keep unset unless you intentionally use a provider URL (e.g. Railway)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=crm_medical_device
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# CRM Data Scope - opt-in, default disabled (A6.11.x)
# These flags mirror config/crm_data_scope.php. Configure View scopes per role
# in the Roles UI before enabling. A NULL data_scope must NOT imply All.
# Enabling one flag may also restrict linked modules, reports and exports.
# -----------------------------------------------------------------------------
CRM_DATA_SCOPE_CUSTOMERS_ENABLED=false
CRM_DATA_SCOPE_LEADS_ENABLED=false
CRM_DATA_SCOPE_OPPORTUNITIES_ENABLED=false
CRM_DATA_SCOPE_SERVICE_TICKETS_ENABLED=false
CRM_DATA_SCOPE_MAINTENANCE_ENABLED=false
CRM_DATA_SCOPE_INSTALLATIONS_ENABLED=false
CRM_DATA_SCOPE_ACTIVITIES_ENABLED=false

# NOTE: A6.11.7.3 runtime tests are postponed; do not put test UUIDs here.
# Never run feature tests against the main CRM database.

